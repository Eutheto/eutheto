{
  "name": "@eutheto/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite",
    "e2e": "wdio run ./wdio.conf.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit --project e2e/tsconfig.json"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/mocha": "10.0.10",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-sfc": "3.5.42",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/server-renderer": "3.5.42",
    "@wdio/cli": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "mocha": "10.8.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.2.6"
  }
}
